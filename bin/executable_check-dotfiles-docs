#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$root"

fail=0
ok() { printf 'ok: %s\n' "$1"; }
bad() { printf 'FAIL: %s\n' "$1" >&2; fail=1; }

absent() {
  local path="$1" message="$2"
  if [[ ! -e "$path" ]]; then ok "$message"; else bad "$message"; fi
}

renders() {
  local data="$1" message="$2"
  if chezmoi execute-template --override-data "$data" < .chezmoiignore >/dev/null 2>&1; then
    ok "$message"
  else
    bad "$message"
  fi
}

rejects() {
  local data="$1" message="$2"
  if chezmoi execute-template --override-data "$data" < .chezmoiignore >/dev/null 2>&1; then
    bad "$message"
  else
    ok "$message"
  fi
}

renders '{"profile":"personal","chezmoi":{"os":"darwin","osRelease":{"id":""}}}' \
  'supported machine renders: personal macOS'
renders '{"profile":"work","chezmoi":{"os":"darwin","osRelease":{"id":""}}}' \
  'supported machine renders: work macOS'
renders '{"profile":"personal","chezmoi":{"os":"linux","osRelease":{"id":"fedora"}}}' \
  'supported machine renders: personal Fedora'

rejects '{"profile":"server","chezmoi":{"os":"linux","osRelease":{"id":"debian"}}}' \
  'removed profile is rejected: server'
rejects '{"profile":"cachygaming","chezmoi":{"os":"linux","osRelease":{"id":"fedora"}}}' \
  'removed profile is rejected: cachygaming'
rejects '{"profile":"work","chezmoi":{"os":"linux","osRelease":{"id":"fedora"}}}' \
  'unsupported machine is rejected: work Fedora'
rejects '{"profile":"personal","chezmoi":{"os":"linux","osRelease":{"id":"arch"}}}' \
  'unsupported machine is rejected: personal Arch'

if [[ -f bootstrap && -f scripts/install-packages.sh.tmpl ]]; then
  ok 'explicit bootstrap files exist'
else
  bad 'explicit bootstrap files are missing'
fi

managed="$(chezmoi managed)"
for source_only in PLAN.md bootstrap scripts plans archive macos linux; do
  if printf '%s\n' "$managed" | grep -Eq "^${source_only}(/|$)"; then
    bad "source-only path would leak into HOME: $source_only"
  else
    ok "source-only path is not managed: $source_only"
  fi
done

absent private_dot_ssh/encrypted_private_id_ed25519.age 'encrypted SSH private key source is absent'
absent private_dot_ssh/id_ed25519.pub 'machine-specific SSH public key source is absent'
if find private_dot_ssh -type f -name '*.age' -print -quit | grep -q .; then
  bad 'encrypted SSH material still exists'
else
  ok 'SSH directory contains no encrypted material'
fi
if grep -Eq '^\.ssh/id_ed25519($|\.)' .chezmoiremove; then
  bad '.chezmoiremove must not delete machine-local SSH keys'
else
  ok '.chezmoiremove preserves machine-local SSH keys'
fi

exit "$fail"
