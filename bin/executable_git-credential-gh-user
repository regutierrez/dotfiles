#!/usr/bin/env bash
# Git credential helper that always uses a specific gh account's token.
# Usage in repo-local config:
#   git config --local credential.https://github.com.helper ''
#   git config --local --add credential.https://github.com.helper 'gh-user regutierrez'
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: git-credential-gh-user <github-username> <get|store|erase>" >&2
  exit 1
fi

user="$1"
action="$2"

case "$action" in
  get)
    if ! command -v gh >/dev/null 2>&1; then
      echo "git-credential-gh-user: gh not found" >&2
      exit 1
    fi
    token="$(gh auth token --user "$user" 2>/dev/null || true)"
    if [[ -z "$token" ]]; then
      echo "git-credential-gh-user: no gh token for user '$user' (run: gh auth login -u $user)" >&2
      exit 1
    fi
    printf 'username=%s\npassword=%s\n' "$user" "$token"
    ;;
  store | erase)
    # Tokens live in gh's keyring; nothing to persist here.
    exit 0
    ;;
  *)
    echo "git-credential-gh-user: unknown action '$action'" >&2
    exit 1
    ;;
esac
