{{- $osid := index .chezmoi.osRelease "id" | default "" -}}
{{- $variant := index .chezmoi.osRelease "variantID" | default "" -}}
{{- /* Fedora Cloud is headless; open-computer-use needs a desktop session. */ -}}
{{- $headlessCloud := and (eq .chezmoi.os "linux") (eq $osid "fedora") (eq $variant "cloud") -}}
{
  "mcp": {
    "toolMode": "proxy",
    "startup": "lazy",
    "servers": {
{{- if not $headlessCloud }}
      "computer": {
        "type": "local",
        "command": [
          "open-computer-use",
          "mcp"
        ],
        "enabled": true,
        "timeout": 60000
      },
{{- end }}
{{- if eq .profile "work" }}
      "executor": {
        "type": "remote",
        "url": "http://127.0.0.1:4788/mcp",
        "enabled": true,
        "headers": {
          "Authorization": "Bearer ${EXECUTOR_API_KEY}"
        }
      },
{{- end }}
      "executor-personal": {
        "type": "remote",
        "url": "https://executor.esquie.pael.dev/mcp",
        "enabled": true,
        "headers": {
          "Authorization": "Bearer ${EXECUTOR_PERSONAL_API_KEY}"
        }
      }
    }
  }
}
