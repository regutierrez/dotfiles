{{- /* chezmoi:modify-template */ -}}
{{- $data := dict -}}
{{- if and (hasKey .chezmoi "stdin") .chezmoi.stdin -}}
{{-   $data = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $data = $data | setValueAtPath "doubleEscapeAction" "none" -}}
{{- /* Pi uses npm. Drop leftover Bun package-manager overrides. */ -}}
{{- $data = omit $data "npmCommand" -}}
{{- /* Drop retired packages. */ -}}
{{- if hasKey $data "packages" -}}
{{-   $packages := list -}}
{{-   range $entry := index $data "packages" -}}
{{-     if and (kindIs "string" $entry) (eq $entry "git:github.com/regutierrez/pi-herdr-subagents") -}}
{{-     else if and (kindIs "map" $entry) (eq (index $entry "source") "git:github.com/regutierrez/pi-herdr-subagents") -}}
{{-     else if and (kindIs "string" $entry) (eq $entry "npm:sideshow") -}}
{{-     else if and (kindIs "map" $entry) (eq (index $entry "source") "npm:sideshow") -}}
{{-     else -}}
{{-       $packages = append $packages $entry -}}
{{-     end -}}
{{-   end -}}
{{-   $data = $data | setValueAtPath "packages" $packages -}}
{{- end -}}
{{ $data | toPrettyJson }}
