{{- /* chezmoi:modify-template */ -}}
{{- /* Keep ~/.claude.json machine-local (sign-in, project state, history)
     except the executor MCP servers, which mirror Pi
     (dot_pi/agent/mcp.json.tmpl). Work `executor` is work-profile only.
     Amp MCP stays machine-local. */ -}}
{{- $data := dict -}}
{{- if and (hasKey .chezmoi "stdin") .chezmoi.stdin -}}
{{-   $data = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- if eq .profile "work" -}}
{{-   $executor := dict
        "type" "http"
        "url" "http://127.0.0.1:4788/mcp"
        "headers" (dict "Authorization" "Bearer ${EXECUTOR_API_KEY}")
  -}}
{{-   $data = $data | setValueAtPath "mcpServers.executor" $executor -}}
{{- else if hasKey $data "mcpServers" -}}
{{-   $mcpServers := index $data "mcpServers" -}}
{{-   if kindIs "map" $mcpServers -}}
{{-     $data = $data | setValueAtPath "mcpServers" (omit $mcpServers "executor") -}}
{{-   end -}}
{{- end -}}
{{- $executorPersonal := dict
      "type" "http"
      "url" "https://executor.esquie.pael.dev/mcp"
      "headers" (dict "Authorization" "Bearer ${EXECUTOR_PERSONAL_API_KEY}")
-}}
{{- $data = $data | setValueAtPath "mcpServers.executor-personal" $executorPersonal -}}
{{ $data | toPrettyJson }}
