{{- /* Ensure required Pi packages are present. */ -}}
#!/bin/bash
set -euo pipefail

if ! command -v pi >/dev/null 2>&1; then
  echo "install-pi-packages: pi not found, skipping" >&2
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "install-pi-packages: node not found, skipping" >&2
  exit 0
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "install-pi-packages: bun not found, skipping" >&2
  exit 0
fi

agent_dir="${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}"
settings="${agent_dir}/settings.json"

# Uninstall packages retired from [packages.pi]. Settings may already have
# dropped them via modify_settings.json; still delete leftover checkouts.
retired_herdr_subagents="git:github.com/regutierrez/pi-herdr-subagents"
retired_herdr_checkout="${agent_dir}/git/github.com/regutierrez/pi-herdr-subagents"
if node - "$settings" "$retired_herdr_subagents" <<'NODE'
const fs = require("node:fs");
const [, , settingsPath, source] = process.argv;
try {
  const settings = JSON.parse(fs.readFileSync(settingsPath, "utf8"));
  const configured = (settings.packages ?? []).some((entry) =>
    (typeof entry === "string" ? entry : entry?.source) === source
  );
  process.exit(configured ? 0 : 1);
} catch {
  process.exit(1);
}
NODE
then
  echo "install-pi-packages: removing retired ${retired_herdr_subagents}..."
  pi remove "$retired_herdr_subagents"
elif [ -e "$retired_herdr_checkout" ]; then
  echo "install-pi-packages: removing leftover ${retired_herdr_checkout}"
  rm -rf "$retired_herdr_checkout"
fi

packages=(
{{- range .packages.pi.extensions }}
  {{ . | quote }}
{{- end }}
)

for source in "${packages[@]}"; do
  if node - "$settings" "$source" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");

const [, , settingsPath, source] = process.argv;
const agentDir = path.dirname(settingsPath);

function packageJsonPath(source) {
  if (source.startsWith("npm:")) {
    let name = source.slice("npm:".length);
    if (name.startsWith("@")) {
      name = name.replace(/^(@[^/]+\/[^@]+)(?:@.+)?$/, "$1");
    } else {
      name = name.replace(/^([^@]+)(?:@.+)?$/, "$1");
    }
    return path.join(agentDir, "npm", "node_modules", ...name.split("/"), "package.json");
  }

  if (source.startsWith("git:")) {
    let rest = source.slice("git:".length);
    const slash = rest.lastIndexOf("/");
    const at = rest.lastIndexOf("@");
    if (at > slash) {
      rest = rest.slice(0, at);
    }
    return path.join(agentDir, "git", ...rest.split("/"), "package.json");
  }

  return null;
}

let settings;
try {
  settings = JSON.parse(fs.readFileSync(settingsPath, "utf8"));
} catch {
  process.exit(1);
}

const configured = (settings.packages ?? []).some((entry) =>
  (typeof entry === "string" ? entry : entry?.source) === source
);
const packageJson = packageJsonPath(source);
process.exit(configured && packageJson && fs.existsSync(packageJson) ? 0 : 1);
NODE
  then
    echo "install-pi-packages: ${source} already installed"
  else
    echo "install-pi-packages: installing ${source}..."
    pi install "$source"
  fi
done

npm_prefix="${NPM_CONFIG_PREFIX:-${HOME}/.npm-global}"
mkdir -p "${npm_prefix}"
export PATH="${npm_prefix}/bin:${PATH}"

{{- $osid := index .chezmoi.osRelease "id" | default "" -}}
{{- $variant := index .chezmoi.osRelease "variantID" | default "" -}}
{{- $headlessCloud := and (eq .chezmoi.os "linux") (eq $osid "fedora") (eq $variant "cloud") }}

npm_globals=(
{{- if not $headlessCloud }}
{{- range (.packages.npm.globals | default list) }}
  {{ . | quote }}
{{- end }}
{{- end }}
)

for pkg in "${npm_globals[@]+"${npm_globals[@]}"}"; do
  # Package name may include a scope; binary often matches the unscoped name.
  bin_name="${pkg##*/}"
  if command -v "${bin_name}" >/dev/null 2>&1; then
    echo "install-pi-packages: npm global ${pkg} already present"
  else
    echo "install-pi-packages: installing npm global ${pkg}..."
    npm --prefix "${npm_prefix}" install -g "${pkg}"
  fi
done
