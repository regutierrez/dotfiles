{{- /* Supported: personal and work. */ -}}
{{- $profile := promptStringOnce . "profile" "profile" "personal" }}
{{- $defaultGithubAccount := "regutierrez" -}}
{{- if eq $profile "work" -}}
{{-   $defaultGithubAccount = "pael-akkio" -}}
{{- end -}}
{{- $githubDefaultAccount := promptStringOnce . "github_default_account" "default GitHub account" $defaultGithubAccount }}
{{- if and (ne $profile "personal") (ne $profile "work") -}}
{{-   fail (printf "unsupported profile %q; expected personal or work" $profile) -}}
{{- end }}
{{- if and (ne $githubDefaultAccount "regutierrez") (ne $githubDefaultAccount "pael-akkio") (ne $githubDefaultAccount "pael-hz") -}}
{{-   fail (printf "unsupported default GitHub account %q" $githubDefaultAccount) -}}
{{- end }}
{{- $osid := index .chezmoi.osRelease "id" | default "" -}}
{{- $supportedOS := or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (eq $osid "fedora")) -}}
{{- if not $supportedOS -}}
{{-   fail "supported machines are macOS and Fedora" -}}
{{- end }}
[edit]
    apply = true
    watch = true

[update]
    apply = true

[data]
    profile = "{{ $profile }}"
    github_default_account = "{{ $githubDefaultAccount }}"
