[Unit]
Description=Remap keyboard with xremap
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xremap --watch=config,device %h/.config/xremap/config.yml
Restart=on-failure
RestartSec=2

# Start after the session imports WAYLAND_DISPLAY/DISPLAY into the user
# manager, so apps launched by remaps inherit a usable display environment.
[Install]
WantedBy=graphical-session.target
