{{- /* Install runtime npm deps for the vendored Pi MCP extension.
       The rendered checksum makes run_onchange_ rerun when package metadata changes. */ -}}
#!/bin/bash
set -euo pipefail

# package.json: {{ include "dot_pi/agent/extensions/pi-mcp/package.json" | sha256sum }}
# package-lock.json: {{ include "dot_pi/agent/extensions/pi-mcp/package-lock.json" | sha256sum }}

extension_dir="${HOME}/.pi/agent/extensions/pi-mcp"

if ! command -v npm >/dev/null 2>&1; then
  echo "install-pi-mcp: npm not found, skipping" >&2
  exit 0
fi

if [ ! -f "${extension_dir}/package-lock.json" ]; then
  echo "install-pi-mcp: ${extension_dir}/package-lock.json not found, skipping" >&2
  exit 0
fi

echo "install-pi-mcp: syncing runtime npm dependencies..."
npm --prefix "${extension_dir}" ci --omit=dev
{{- /* Keep the rendered EOF stable for run_onchange_ checksum comparisons. */ -}}
