{{- $profile := (index . "profile" | default "personal") -}}
{{- if and (ne $profile "personal") (ne $profile "work") -}}
{{-   fail (printf "unsupported profile %q; expected personal or work" $profile) -}}
{{- end -}}
{{- $osid := index .chezmoi.osRelease "id" | default "" -}}
{{- if and (eq $profile "work") (ne .chezmoi.os "darwin") -}}
{{-   fail "the work profile supports macOS only" -}}
{{- end -}}
{{- $personalOS := or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (eq $osid "fedora")) -}}
{{- if and (eq $profile "personal") (not $personalOS) -}}
{{-   fail "the personal profile supports macOS and Fedora only" -}}
{{- end -}}
{{- $skillGroups := list "shared" -}}
{{- if eq $profile "work" -}}
{{-   $skillGroups = list "shared" "work" -}}
{{- end -}}

