{{- $work := eq .profile "work" -}}
{
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "Hyper Key (Caps Lock variable, Escape if alone)",
            "manipulators": [
              {
                "description": "Caps Lock -> Hyper Key",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "hyper",
                      "value": 1
                    }
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "hyper",
                      "value": 0
                    }
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "escape"
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Hyper Key sublayer \"q\"",
            "manipulators": [
              {
                "conditions": [
                  {
                    "name": "hyper",
                    "type": "variable_if",
                    "value": 1
                  }
                ],
                "description": "Toggle Hyper sublayer q",
                "from": {
                  "key_code": "q",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "hyper_sublayer_q",
                      "value": 1
                    }
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "hyper_sublayer_q",
                      "value": 0
                    }
                  }
                ],
                "type": "basic"
              },
              {
                "conditions": [
                  {
                    "name": "hyper",
                    "type": "variable_if",
                    "value": 1
                  },
                  {
                    "name": "hyper_sublayer_q",
                    "type": "variable_if",
                    "value": 1
                  }
                ],
